# Complete original WP3 bytes are delivered in the verified public archive/index.
# The loose originals remain intact locally; no outcome or failed candidate is dropped.
/results/revision-v8/wp3/units/
/results/revision-v8/wp3/inventory.json
# Every v9 unit byte is retained locally and published through its ZIP plus SHA index.
/results/v9/nonstationarity/*/units/
# Lossless <=20MiB public parts reconstruct this intact local archive.
/results/v9/nonstationarity/formal/units.zip
# Incomplete writer bytes are retained here and published verbatim as postrun/*.txt.
/results/v9/nonstationarity/predictions.json
# Intermediate v9 table backups stay local and outside the submission package.
/submission-jof/generated/v9-*.bak
